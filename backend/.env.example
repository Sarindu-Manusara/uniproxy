PORT=8081
SPRING_PROFILES_ACTIVE=local

# Local H2 profile does not need production database values.
# For Supabase/PostgreSQL production, set these in Render:
# Prefer Supabase Session pooler for this Spring Boot backend.
# Example host format: aws-0-region.pooler.supabase.com:5432
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.project_ref
SPRING_DATASOURCE_PASSWORD=your-supabase-database-password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000

APP_BASE_URL=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: seed hosted login accounts on backend startup.
APP_SEED_USER_USERNAME=user
APP_SEED_USER_EMAIL=user@uniproxy.local
APP_SEED_USER_PASSWORD=change-this-user-password
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_EMAIL=admin@uniproxy.local
APP_SEED_ADMIN_PASSWORD=change-this-admin-password

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1/payment

CATPROXIES_API_KEY=cp_your_api_key_here
CATPROXIES_API_BASE_URL=https://catproxies.com/api/v1/public
