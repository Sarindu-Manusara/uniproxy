PORT=8081
SPRING_PROFILES_ACTIVE=local

# Local H2 profile does not need MySQL values.
# For MySQL/prod, set these:
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/proxy_system
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000

APP_BASE_URL=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1/payment

CATPROXIES_API_KEY=cp_your_api_key_here
CATPROXIES_API_BASE_URL=https://catproxies.com/api/v1/public
